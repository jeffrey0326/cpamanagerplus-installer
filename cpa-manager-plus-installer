#!/bin/bash

# CPA Manager Plus Linux Installer
# 自动安装或更新 CPA Manager Plus (https://github.com/seakee/CPA-Manager-Plus)
# 支持 native 二进制包和 Docker 两种部署模式

# set -euo pipefail
set -eu
# ─── 常量 ──────────────────────────────────────────────────────────────────
REPO_OWNER="seakee"
REPO_NAME="CPA-Manager-Plus"
INSTALL_DIR="$HOME/cpa-manager-plus"
API_URL="https://api.github.com/repos/${REPO_OWNER}/${REPO_NAME}/releases/latest"
SCRIPT_NAME="cpa-manager-plus-installer"
SERVICE_NAME="cpa-manager-plus"
DEFAULT_PORT="18317"

# ─── 颜色 ──────────────────────────────────────────────────────────────────
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

# ─── 日志（全部输出到 stderr，避免污染子 shell 的 stdout 捕获） ─────────────
log_info()    { echo -e "${BLUE}[INFO]${NC} $1"   >&2; }
log_success() { echo -e "${GREEN}[OK]${NC}   $1"  >&2; }
log_warning() { echo -e "${YELLOW}[WARN]${NC} $1" >&2; }
log_error()   { echo -e "${RED}[ERR]${NC}  $1"    >&2; }
log_step()    { echo -e "${CYAN}[STEP]${NC} $1"   >&2; }
log_banner()  { echo -e "${BOLD}${BLUE}$1${NC}"   >&2; }

# ─── 工具检测 ───────────────────────────────────────────────────────────────
has_cmd() { command -v "$1" >/dev/null 2>&1; }

check_dependencies() {
    local missing=()
    { has_cmd curl || has_cmd wget; } || missing+=("curl 或 wget")
    has_cmd tar || missing+=("tar")
    if [[ ${#missing[@]} -gt 0 ]]; then
        log_error "缺少依赖工具: ${missing[*]}"
        log_info  "Ubuntu/Debian: sudo apt-get install -y curl tar"
        log_info  "CentOS/RHEL:   sudo yum install -y curl tar"
        exit 1
    fi
}

# ─── 架构检测 ───────────────────────────────────────────────────────────────
detect_arch() {
    case "$(uname -m)" in
        x86_64|amd64)  echo "linux_amd64"  ;;
        arm64|aarch64) echo "linux_arm64"  ;;
        *)
            log_error "不支持的架构: $(uname -m)（仅支持 x86_64 / aarch64）"
            exit 1
            ;;
    esac
}

# ─── HTTP 封装 ───────────────────────────────────────────────────────────────
# 所有函数只通过 stdout 返回数据，日志走 stderr
http_get() {
    if has_cmd curl; then
        curl -fsSL -H "User-Agent: ${SCRIPT_NAME}/1.0" "$1"
    else
        wget -qO- --user-agent="${SCRIPT_NAME}/1.0" "$1"
    fi
}

http_download() {
    local url="$1" out="$2"
    log_info "下载 $(basename "$url") ..."
    if has_cmd curl; then
        curl -fSL -H "User-Agent: ${SCRIPT_NAME}/1.0" \
            --progress-bar -o "$out" "$url" 2>&1 | grep -v "^$" >&2 || true
        # fallback: 静默模式（有些环境 progress-bar 有问题）
        [[ -s "$out" ]] || curl -fsSL -H "User-Agent: ${SCRIPT_NAME}/1.0" -o "$out" "$url"
    else
        wget -qO "$out" --user-agent="${SCRIPT_NAME}/1.0" "$url"
    fi
    [[ -f "$out" && -s "$out" ]] || { log_error "下载失败: $url"; exit 1; }
    log_success "下载完成 ($(du -h "$out" | cut -f1))"
}

# ─── 版本获取 ─────────────────────────────────────────────────────────────────
# 返回完整 tag（含 v），如 "v1.4.0"；失败返回空字符串
# 日志全走 stderr，stdout 只输出 tag
fetch_latest_tag() {
    local info tag

    # 方法1：GitHub API
    log_info "查询最新版本（GitHub API）..."
    if info=$(http_get "$API_URL" 2>/dev/null) && [[ -n "$info" ]]; then
        if ! echo "$info" | grep -q '"message"'; then
            # API 正常返回
            tag=$(echo "$info" \
                | grep -o '"tag_name"[[:space:]]*:[[:space:]]*"[^"]*"' \
                | head -1 \
                | grep -o '"[^"]*"$' \
                | tr -d '"')
            if [[ -n "$tag" ]]; then
                log_info "API 返回版本: $tag"
                echo "$tag"
                return
            fi
        fi
        log_warning "API 受限或返回异常，切换备用方案..."
    fi

    # 方法2：HTTP 重定向（不消耗 API 配额）
    log_info "通过 releases/latest 重定向获取版本..."
    local location
    if has_cmd curl; then
        location=$(curl -fsSLI \
            -H "User-Agent: ${SCRIPT_NAME}/1.0" \
            "https://github.com/${REPO_OWNER}/${REPO_NAME}/releases/latest" \
            2>/dev/null \
            | grep -i '^location:' | tail -1 \
            | tr -d '\r' | sed 's/^[Ll]ocation:[[:space:]]*//')
    else
        location=$(wget -qS --spider \
            --user-agent="${SCRIPT_NAME}/1.0" \
            "https://github.com/${REPO_OWNER}/${REPO_NAME}/releases/latest" \
            2>&1 | grep -i 'Location:' | tail -1 | awk '{print $2}' | tr -d '\r')
    fi

    if [[ -n "$location" ]]; then
        # location 形如 https://github.com/owner/repo/releases/tag/v1.4.0
        tag=$(echo "$location" | grep -o '[^/]*$')
        if [[ "$tag" == v* || "$tag" =~ ^[0-9] ]]; then
            log_info "重定向返回版本: $tag"
            echo "$tag"
            return
        fi
    fi

    log_error "无法获取最新版本号，请检查网络连通性"
    exit 1
}

# ─── 下载 URL 构造 ────────────────────────────────────────────────────────────
# CPA-Manager-Plus asset 文件名格式：cpa-manager-plus_v1.4.0_linux_amd64.tar.gz
#   tag     = "v1.4.0"
#   filename = "cpa-manager-plus_v1.4.0_linux_amd64.tar.gz"
build_download_url() {
    local tag="$1" arch="$2"
    # 确保 tag 带 v 前缀（asset 文件名包含完整 tag）
    local vtag="${tag#v}"   # 去掉可能的 v，得 1.4.0
    local filename="cpa-manager-plus_v${vtag}_${arch}.tar.gz"
    echo "https://github.com/${REPO_OWNER}/${REPO_NAME}/releases/download/${tag}/${filename}"
}

# 从 tag 提取纯版本号（用于目录名和 version.txt）
tag_to_version() {
    echo "${1#v}"
}

# ─── 安装状态 ───────────────────────────────────────────────────────────────
is_installed() { [[ -f "${INSTALL_DIR}/version.txt" ]]; }

get_installed_version() {
    if is_installed; then
        cat "${INSTALL_DIR}/version.txt" 2>/dev/null || echo "none"
    else
        echo "none"
    fi
}

# ─── 数据备份 ───────────────────────────────────────────────────────────────
backup_data_dir() {
    local data_dir="${INSTALL_DIR}/data"
    [[ -d "$data_dir" ]] || return 0
    local backup_dir="${INSTALL_DIR}/backups"
    mkdir -p "$backup_dir"
    local ts; ts=$(date +"%Y%m%d_%H%M%S")
    local backup="${backup_dir}/data_backup_${ts}"
    cp -a "$data_dir" "$backup"
    log_success "数据目录已备份至: $backup"
}

# ─── systemd 服务 ────────────────────────────────────────────────────────────
is_service_running() {
    systemctl --user is-active --quiet "${SERVICE_NAME}.service" 2>/dev/null
}

is_process_running() {
    pgrep -f "cpa-manager-plus" >/dev/null 2>&1
}

stop_service() {
    if is_service_running; then
        log_info "停止 systemd 服务..."
        systemctl --user stop "${SERVICE_NAME}.service" 2>/dev/null || true
        log_success "服务已停止"
    fi
    if is_process_running; then
        log_info "终止残留进程..."
        pkill -f "cpa-manager-plus" 2>/dev/null || true
        sleep 1
        pkill -9 -f "cpa-manager-plus" 2>/dev/null || true
        log_success "进程已终止"
    fi
}

start_service() {
    log_info "启动 systemd 服务..."
    systemctl --user start "${SERVICE_NAME}.service" 2>/dev/null || true
    sleep 2
    if is_service_running; then
        log_success "服务已启动"
    else
        log_warning "服务可能未正常启动，请检查: systemctl --user status ${SERVICE_NAME}.service"
    fi
}

create_systemd_service() {
    local install_dir="$1"
    local systemd_dir="$HOME/.config/systemd/user"
    local service_file="${systemd_dir}/${SERVICE_NAME}.service"
    mkdir -p "$systemd_dir"
    cat > "$service_file" << EOF
[Unit]
Description=CPA Manager Plus Service
After=network.target

[Service]
Type=simple
WorkingDirectory=${install_dir}
ExecStart=${install_dir}/cpa-manager-plus
Restart=always
RestartSec=10
Environment=HOME=${HOME}
Environment=USAGE_DATA_DIR=${install_dir}/data

[Install]
WantedBy=default.target
EOF
    systemctl --user daemon-reload 2>/dev/null \
        || log_warning "daemon-reload 失败（首次安装时正常）"
    log_success "systemd 服务文件已写入: $service_file"
}

# ─── 解压安装 ────────────────────────────────────────────────────────────────
extract_and_install() {
    local archive="$1" version="$2"
    local ver_dir="${INSTALL_DIR}/${version}"

    log_info "解压到 ${ver_dir}..."
    mkdir -p "$ver_dir"

    # 检测 tar 包内是否有顶层目录
    local top_dir
    top_dir=$(tar -tzf "$archive" 2>/dev/null | head -1 | cut -d/ -f1)
    if [[ -n "$top_dir" && "$top_dir" != "." && "$top_dir" != "./" ]]; then
        tar -xzf "$archive" -C "$ver_dir" --strip-components=1
    else
        tar -xzf "$archive" -C "$ver_dir"
    fi

    # 查找二进制
    local binary
    binary=$(find "$ver_dir" -maxdepth 2 -name "cpa-manager-plus" -type f 2>/dev/null | head -1)
    if [[ -z "$binary" ]]; then
        # fallback：找第一个有执行位的文件
        binary=$(find "$ver_dir" -maxdepth 2 -type f -perm /111 2>/dev/null \
                 | grep -v '\.txt\|\.md\|\.yaml\|\.yml\|\.json\|\.sh' | head -1)
    fi
    if [[ -z "$binary" ]]; then
        log_error "在解压目录中找不到可执行文件，内容如下："
        find "$ver_dir" -maxdepth 3 >&2
        exit 1
    fi

    chmod +x "$binary"
    cp "$binary" "${INSTALL_DIR}/cpa-manager-plus"
    chmod +x "${INSTALL_DIR}/cpa-manager-plus"
    log_success "二进制已安装: ${INSTALL_DIR}/cpa-manager-plus"
}

ensure_data_dir() {
    local data_dir="${INSTALL_DIR}/data"
    mkdir -p "$data_dir"
    chmod 700 "$data_dir"
    log_success "数据目录就绪: $data_dir"
}

cleanup_old_versions() {
    [[ -d "$INSTALL_DIR" ]] || return 0
    local old
    old=$(find "$INSTALL_DIR" -maxdepth 1 -type d \
        | grep -E '/[0-9]+\.[0-9]' \
        | sort -V \
        | head -n -2 2>/dev/null) || true
    [[ -n "$old" ]] || return 0
    while IFS= read -r dir; do
        [[ -n "$dir" ]] || continue
        rm -rf "$dir"
        log_info "已清理旧版本: $(basename "$dir")"
    done <<< "$old"
}

write_version() { echo "$1" > "${INSTALL_DIR}/version.txt"; }

# ─── 安装后提示 ─────────────────────────────────────────────────────────────
show_first_run_guide() {
    echo >&2
    log_banner "════════════════════════════════════════════════════"
    log_banner "  CPA Manager Plus 安装完成 — 首次配置指南"
    log_banner "════════════════════════════════════════════════════"
    echo >&2
    echo -e "${GREEN}▶ 1. 启动服务${NC}" >&2
    echo -e "   直接运行  : ${CYAN}${INSTALL_DIR}/cpa-manager-plus${NC}" >&2
    echo -e "   systemd   : ${CYAN}systemctl --user enable --now ${SERVICE_NAME}.service${NC}" >&2
    echo >&2
    echo -e "${GREEN}▶ 2. 获取 Admin Key（首次启动时日志中打印一次）${NC}" >&2
    echo -e "   ${CYAN}journalctl --user -u ${SERVICE_NAME}.service | grep 'admin key'${NC}" >&2
    echo >&2
    echo -e "${GREEN}▶ 3. 打开管理面板，完成 Setup${NC}" >&2
    echo -e "   ${CYAN}http://<host>:${DEFAULT_PORT}/management.html${NC}" >&2
    echo -e "   填写: Admin Key / CPA URL / CPA 管理密钥" >&2
    echo >&2
    echo -e "${GREEN}▶ 重要文件${NC}" >&2
    echo -e "   数据 SQLite  : ${CYAN}${INSTALL_DIR}/data/usage.sqlite${NC}" >&2
    echo -e "   加密密钥     : ${CYAN}${INSTALL_DIR}/data/data.key${NC}  ← 务必与 sqlite 一同备份！" >&2
    echo >&2
    echo -e "${GREEN}▶ 可选环境变量（无人值守启动，写入 systemd 覆盖文件）${NC}" >&2
    echo -e "   ${YELLOW}CPA_MANAGER_ADMIN_KEY${NC}  — 固定 admin key，避免重启后重新获取" >&2
    echo -e "   ${YELLOW}CPA_UPSTREAM_URL${NC}       — CPA 地址（如 http://localhost:8317）" >&2
    echo -e "   ${YELLOW}CPA_MANAGEMENT_KEY${NC}     — CPA 管理密钥" >&2
    echo -e "   ${YELLOW}HTTP_ADDR${NC}              — 监听地址（默认 0.0.0.0:${DEFAULT_PORT}）" >&2
    echo >&2
    echo -e "${BLUE}文档: https://github.com/${REPO_OWNER}/${REPO_NAME}${NC}" >&2
    echo >&2
}

show_upgrade_guide() {
    local old_ver="$1" new_ver="$2"
    echo >&2
    log_banner "════════════════════════════════════════════════════"
    log_banner "  升级完成:  v${old_ver}  →  v${new_ver}"
    log_banner "════════════════════════════════════════════════════"
    echo >&2
    echo -e "  数据目录已保留  : ${CYAN}${INSTALL_DIR}/data/${NC}" >&2
    echo -e "  备份位置        : ${CYAN}${INSTALL_DIR}/backups/${NC}" >&2
    echo -e "  面板地址        : ${CYAN}http://<host>:${DEFAULT_PORT}/management.html${NC}" >&2
    echo >&2
}

# ─── install ─────────────────────────────────────────────────────────────────
cmd_install() {
    local is_upgrade=false service_was_running=false
    local installed_ver; installed_ver=$(get_installed_version)

    if [[ "$installed_ver" != "none" ]]; then
        is_upgrade=true
        log_info "已安装版本: v${installed_ver}"
        is_service_running && service_was_running=true || true
    else
        log_info "未检测到已安装版本，执行首次安装"
    fi

    check_dependencies

    local arch; arch=$(detect_arch)
    log_step "平台架构: $arch"

    # 获取最新 tag
    local tag; tag=$(fetch_latest_tag)
    local version; version=$(tag_to_version "$tag")  # 去掉 v 前缀，用于目录名
    log_step "最新版本: $tag"

    # 检查是否已是最新
    if [[ "$is_upgrade" == true && "$installed_ver" == "$version" ]]; then
        log_success "已是最新版本 (v${version})，无需更新"
        return
    fi

    # 构造下载 URL（文件名保留 v 前缀）
    local dl_url; dl_url=$(build_download_url "$tag" "$arch")
    log_info "下载地址: $dl_url"

    # 升级前停服、备份
    if [[ "$is_upgrade" == true ]]; then
        stop_service
        backup_data_dir
    fi

    mkdir -p "$INSTALL_DIR"

    # 下载到临时文件
    local tmp; tmp=$(mktemp --suffix=.tar.gz)
    trap 'rm -f "$tmp"' EXIT

    http_download "$dl_url" "$tmp"

    extract_and_install "$tmp" "$version"
    rm -f "$tmp"
    trap - EXIT

    ensure_data_dir
    create_systemd_service "$INSTALL_DIR"
    write_version "$version"
    log_success "版本已记录: $version"
    cleanup_old_versions

    if [[ "$is_upgrade" == true ]]; then
        show_upgrade_guide "$installed_ver" "$version"
        if [[ "$service_was_running" == true ]]; then
            start_service
            log_info "服务已自动重启"
        else
            log_info "如需启动: systemctl --user start ${SERVICE_NAME}.service"
        fi
    else
        show_first_run_guide
    fi
}

# ─── docker ──────────────────────────────────────────────────────────────────
cmd_docker() {
    has_cmd docker || { log_error "未安装 Docker"; exit 1; }

    local container="cpa-manager-plus"
    local data_vol="cpa-manager-plus-data"

    log_info "拉取最新镜像..."
    docker pull seakee/cpa-manager-plus:latest

    if docker ps -a --format '{{.Names}}' 2>/dev/null | grep -qx "$container"; then
        log_info "停止旧容器..."
        docker stop "$container" 2>/dev/null || true
        docker rm   "$container" 2>/dev/null || true
        log_success "旧容器已移除"
    fi

    log_info "启动容器..."
    docker run -d \
        --name  "$container" \
        --restart unless-stopped \
        -p "${DEFAULT_PORT}:${DEFAULT_PORT}" \
        -v "${data_vol}:/data" \
        seakee/cpa-manager-plus:latest

    log_success "容器已启动"
    echo >&2
    log_banner "════════════════════════════════════════════════════"
    log_banner "  Docker 部署完成"
    log_banner "════════════════════════════════════════════════════"
    echo >&2
    echo -e "  ${GREEN}▶ 获取 Admin Key:${NC}" >&2
    echo -e "     ${CYAN}docker logs ${container} 2>&1 | grep 'admin key'${NC}" >&2
    echo >&2
    echo -e "  ${GREEN}▶ 管理面板:${NC}" >&2
    echo -e "     ${CYAN}http://localhost:${DEFAULT_PORT}/management.html${NC}" >&2
    echo >&2
    echo -e "  ${YELLOW}▶ 若 CPA 运行在 Linux 宿主机，需加 --add-host 参数:${NC}" >&2
    echo -e "     先删除: ${CYAN}docker rm -f ${container}${NC}" >&2
    echo -e "     再重建: ${CYAN}docker run -d --name ${container} --restart unless-stopped \\" >&2
    echo -e "               --add-host=host.docker.internal:host-gateway \\" >&2
    echo -e "               -p ${DEFAULT_PORT}:${DEFAULT_PORT} -v ${data_vol}:/data \\" >&2
    echo -e "               seakee/cpa-manager-plus:latest${NC}" >&2
    echo -e "     CPA URL 填: ${CYAN}http://host.docker.internal:8317${NC}" >&2
    echo >&2
}

# ─── status ──────────────────────────────────────────────────────────────────
cmd_status() {
    local ver; ver=$(get_installed_version)
    echo
    echo -e "${BOLD}CPA Manager Plus — 安装状态${NC}"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "  安装目录  : $INSTALL_DIR"
    echo "  当前版本  : ${ver}"

    if [[ "$ver" == "none" ]]; then
        echo "  状态      : 未安装"
        echo
        return
    fi

    [[ -f "${INSTALL_DIR}/cpa-manager-plus" ]] \
        && echo -e "  二进制    : ${GREEN}✅ 存在${NC}" \
        || echo -e "  二进制    : ${RED}❌ 缺失${NC}"

    [[ -d "${INSTALL_DIR}/data" ]] \
        && echo -e "  数据目录  : ${GREEN}✅ ${INSTALL_DIR}/data${NC}" \
        || echo -e "  数据目录  : ${YELLOW}⚠  尚未创建${NC}"

    [[ -f "$HOME/.config/systemd/user/${SERVICE_NAME}.service" ]] \
        && echo -e "  systemd   : ${GREEN}✅ 已安装${NC}" \
        || echo -e "  systemd   : ${YELLOW}⚠  未安装${NC}"

    if is_service_running; then
        echo -e "  运行状态  : ${GREEN}✅ 运行中 (systemd)${NC}"
    elif is_process_running; then
        echo -e "  运行状态  : ${YELLOW}⚠  运行中（非 systemd 管理）${NC}"
    else
        echo -e "  运行状态  : ⏹  未运行"
    fi

    echo "  面板地址  : http://localhost:${DEFAULT_PORT}/management.html"

    local versions
    versions=$(find "$INSTALL_DIR" -maxdepth 1 -type d \
        | grep -E '/[0-9]+\.[0-9]' | sort -V \
        | while IFS= read -r d; do basename "$d"; done) 2>/dev/null || true
    if [[ -n "$versions" ]]; then
        echo "  历史版本  :"
        while IFS= read -r v; do echo "    $v"; done <<< "$versions"
    fi
    echo
}

# ─── uninstall ────────────────────────────────────────────────────────────────
cmd_uninstall() {
    if [[ ! -d "$INSTALL_DIR" ]]; then
        log_warning "未找到安装目录: $INSTALL_DIR"
        exit 0
    fi
    echo
    log_warning "即将卸载 CPA Manager Plus"
    echo -e "  安装目录: ${CYAN}${INSTALL_DIR}${NC}" >&2
    echo
    read -r -p "确定要卸载吗？(y/N): " confirm
    [[ "$confirm" =~ ^[Yy]$ ]] || { log_info "已取消"; exit 0; }
    stop_service || true
    local svc_file="$HOME/.config/systemd/user/${SERVICE_NAME}.service"
    if [[ -f "$svc_file" ]]; then
        systemctl --user disable "${SERVICE_NAME}.service" 2>/dev/null || true
        rm -f "$svc_file"
        systemctl --user daemon-reload 2>/dev/null || true
        log_success "systemd 服务已移除"
    fi
    rm -rf "$INSTALL_DIR"
    log_success "CPA Manager Plus 已完全卸载"
}

# ─── help ─────────────────────────────────────────────────────────────────────
cmd_help() {
    cat << EOF

${BOLD}${BLUE}CPA Manager Plus — Linux 安装脚本${NC}
${BLUE}https://github.com/${REPO_OWNER}/${REPO_NAME}${NC}

${BOLD}用法:${NC}  $SCRIPT_NAME [命令]

