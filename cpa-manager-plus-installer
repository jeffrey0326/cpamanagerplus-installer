  systemctl --user enable --now ${SERVICE_NAME}.service
  journalctl --user -u ${SERVICE_NAME}.service | grep 'admin key'
  # 访问 http://localhost:${DEFAULT_PORT}/management.html

${BOLD}数据安全:${NC}
  升级前自动备份 ~/cpa-manager-plus/backups/
  data/usage.sqlite 与 data/data.key 请一并备份，密钥丢失无法恢复加密数据

EOF
}

# ─── 入口 ─────────────────────────────────────────────────────────────────────
main() {
    case "${1:-install}" in
        install|upgrade) cmd_install   ;;
        docker)          cmd_docker    ;;
        status)          cmd_status    ;;
        uninstall)       cmd_uninstall ;;
        -h|--help|help)  cmd_help      ;;
        *)
            log_error "未知命令: $1"
            echo "使用 '$SCRIPT_NAME --help' 查看帮助" >&2
            exit 1
            ;;
    esac
}

main "$@"
